{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticPrefixChore",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":preserveSemverRanges",
    ":disableRateLimiting"
  ],
  "ignorePresets": [":semanticPrefixFixDepsChoreOthers"],
  "automergeStrategy": "squash"
}
